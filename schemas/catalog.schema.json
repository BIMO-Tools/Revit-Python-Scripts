{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BIMO-Tools/Revit-Python-Scripts/blob/main/schemas/catalog.schema.json",
  "title": "BIMO Run Python script catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "scripts"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "scripts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/script"
      }
    }
  },
  "$defs": {
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "summary",
        "category",
        "path",
        "documentation",
        "engine",
        "revit",
        "risk",
        "requiresActiveDocument",
        "selection",
        "inputs",
        "output",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^[^\\\\]+\\.py$"
        },
        "documentation": {
          "type": "string",
          "pattern": "^[^\\\\]+\\.md$"
        },
        "engine": {
          "enum": ["ironpython", "dynamo-cpython3"]
        },
        "revit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "tested"],
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 2024
            },
            "tested": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 2024
              }
            }
          }
        },
        "risk": {
          "enum": ["read", "write", "destructive"]
        },
        "requiresActiveDocument": {
          "type": "boolean"
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "description"],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "description"],
          "properties": {
            "format": {
              "enum": ["text", "json", "object"]
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "type", "required", "description"],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "enum": ["string", "number-string", "integer-string", "boolean-string", "json-string"]
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
